# BreatheBetterTonight.com — Environment Variables
# Copy this to .env for local development.
# Set secure values in the Railway production environment; do not commit real secrets.

PORT=8080
# Required in production. The application blocks /admin if either value is missing.
ADMIN_USER=admin@example.com
ADMIN_PASS=generate-a-strong-unique-password

# Required in production for retained lead submissions. Set this to a writable
# path on a mounted persistent volume, for example /data/leads.json.
LEADS_FILE=/data/leads.json

# Optional: opens the provider chat in a new tab from the shared chat launcher.
# Leave blank to keep the transparent phone-first fallback panel.
CHAT_PROVIDER_URL=
